# Copy to .env and fill in. .env is ignored by git.

# Required for the integration tests (they are skipped when any is missing)
ONLINEPAYMENTS_API_KEY_ID=
ONLINEPAYMENTS_SECRET_API_KEY=
ONLINEPAYMENTS_MERCHANT_ID=

# Optional: overrides the endpoint from tests/resources/configuration.v1hmac.ini
# ONLINEPAYMENTS_API_ENDPOINT=https://payment.direct.ecom.preprod.worldline-solutions.com

# Used by Factory.create_client_from_env() (not needed for the tests)
# ONLINEPAYMENTS_INTEGRATOR=
# ONLINEPAYMENTS_CONNECT_TIMEOUT=10
# ONLINEPAYMENTS_SOCKET_TIMEOUT=60
